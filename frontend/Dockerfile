# ベースイメージとしてNode.jsのバージョン26を指定する（念のためインストールしたNode.jsのバージョンと一致させる）
FROM node:26
# コンテナ内の作業ディレクトリ（基準となるフォルダ）を /app に設定する
WORKDIR /app
# 依存関係の定義ファイル（package.jsonとpackage-lock.json）をコンテナにコピーする
COPY package\*.json ./
# コピーした定義ファイルをもとに、必要なパッケージ（ライブラリ）をインストールする
RUN npm install
# 残りのソースコードや設定ファイルをすべてコンテナ内にコピーする
COPY . .
# コンテナが外部に公開するポート番号（Viteのデフォルトである5173）を指定する
EXPOSE 5173
# コンテナ起動時に、ホストOS（自分のPC）からアクセスできるよう--hostをつけて開発サーバーを起動する
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]